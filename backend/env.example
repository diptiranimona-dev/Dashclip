# ─────────────────────────────────────────────────────────────────────────────
# DashClip V4 — Environment Variables
# Copy to .env for local development
# Set in Render dashboard for production
# ─────────────────────────────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres:password@localhost:5432/ai_script_video
# Supabase:   postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/ai_script_video

# ── STORAGE ───────────────────────────────────────────────────────────────────
# "local"    = write to local filesystem (default, for development)
# "supabase" = write to Supabase Storage (required for Render deployment)
STORAGE_BACKEND=local

# Supabase — only needed when STORAGE_BACKEND=supabase
# Get from: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
SUPABASE_BUCKET=dashclip-media

# ── STOCK FOOTAGE ─────────────────────────────────────────────────────────────
# Pexels:   https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Pixabay:  https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_key_here

# ── AI PROVIDER ──────────────────────────────────────────────────────────────
# "gemini"  = Google Gemini API (recommended for Render/production)
# "ollama"  = Local Ollama (for local dev or privacy)
# "auto"    = use gemini if GEMINI_API_KEY set, else ollama
DASHCLIP_AI_PROVIDER=auto

# ── GEMINI (Cloud AI — recommended for public beta) ───────────────────────────
# Get free key: https://aistudio.google.com/apikey
# Free tier: 1500 requests/day with gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ── OLLAMA (Local AI — for privacy or offline use) ────────────────────────────
# Install: https://ollama.com
# Pull models: ollama pull qwen2.5:7b
# Ollama does NOT run on Render — for local dev only
OLLAMA_URL=http://127.0.0.1:11434
DASHCLIP_AI_MODEL=qwen2.5:7b
DASHCLIP_AI_MEDIUM=qwen2.5:3b
DASHCLIP_AI_FAST=qwen2.5:1.5b
DASHCLIP_AI_TIMEOUT=360

# ── FILE PATHS (local dev only — overridden in Docker) ───────────────────────
OUTPUT_DIR=/tmp/dashclip/outputs
UPLOAD_DIR=/tmp/dashclip/uploads
TEMP_DIR=/tmp/dashclip/tmp

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Local:      http://127.0.0.1:8000,http://localhost:8000
# Production: https://your-app.onrender.com
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ── OPTIONAL: AI VIDEO GENERATION FALLBACK ────────────────────────────────────
# Used when zero stock clips found for a scene
GOOGLE_AI_API_KEY=
RUNWAYML_API_KEY=
LUMAAI_API_KEY=

# ── MUSIC ─────────────────────────────────────────────────────────────────────
# Jamendo — optional, get key at devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ── SECURITY ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-in-production

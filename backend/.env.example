\# ─────────────────────────────────────────────────────────────
# DashClip V4 — Your Environment Configuration
# ─────────────────────────────────────────────────────────────

# ── STOCK FOOTAGE APIs ────────────────────────────────────────
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgresql://@localhost:5432/ai_script_video
DB_HOST=localhost
DB_PORT=
DB_NAME=ai_script_video
DB_USER=
DB_PASSWORD=

# ── AI MODELS — Qwen via Ollama (no API key needed) ──────────
# Pull these first:
#   ollama pull qwen2.5:7b
#   ollama pull qwen2.5:3b
#   ollama pull qwen2.5:1.5b

# Tier 1 — Complex tasks (script, scenes, director, brain)
DASHCLIP_AI_MODEL=qwen2.5:7b

# Tier 2 — Medium tasks (classification, analysis, tagging)
DASHCLIP_AI_MEDIUM=qwen2.5:3b

# Tier 3 — Fast tasks (keywords, cleanup, metadata)
DASHCLIP_AI_FAST=qwen2.5:1.5b

# Ollama server (default — do not change unless you moved Ollama)
OLLAMA_URL=http://127.0.0.1:11434

# ── FILE PATHS ────────────────────────────────────────────────
OUTPUT_DIR=./outputs
UPLOAD_DIR=./uploads
TEMP_DIR=

# ── MUSIC ─────────────────────────────────────────────────────
# Jamendo is rate-limited — DashClip now uses Free Music Archive instead
# Leave this blank or get a new key from devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ── OPTIONAL — AI VIDEO GENERATION ───────────────────────────
# Only used when zero stock clips found for a scene
# Leave blank if you don't have these keys yet

# Google Veo 2 — https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# RunwayML Gen-3 — https://app.runwayml.com/settings
RUNWAYML_API_KEY=

# Luma AI Dream Machine — https://lumalabs.ai/dream-machine/api
LUMAAI_API_KEY=

# ── NOT USED (kept for reference) ────────────────────────────
# Anthropic Claude — not used, planned for V5 only
# ANTHROPIC_API_KEY=


# AI timeout in seconds — increase if qwen2.5:7b times out (default 360)
DASHCLIP_AI_TIMEOUT=360